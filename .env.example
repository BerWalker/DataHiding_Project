# Copie para .env e ajuste:
#   cp .env.example .env
#
# Coloque o arquivo em ./input/ (montado em /input no container envia).
# O receptor grava em ./output/ (montado em /output no container recebe).

# ── Transferência ─────────────────────────────────────────────
# Caminho do arquivo DENTRO do container envia.
# Deixe vazio para enviar texto (MESSAGE) em vez de arquivo.
FILE_PATH=/input/teste.txt

# Usado só quando FILE_PATH está vazio (modo texto).
MESSAGE=Hello, World!

# ── Rede / timeouts ───────────────────────────────────────────
SERVER_HOST=10.0.1.2
TIMEOUT=120
OUTPUT_DIR=/output
